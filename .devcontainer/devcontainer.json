{
  "name": "Python (uv Dev)",

  // Build using the 'development' stage of our root Dockerfile
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "development"
  },

  "remoteUser": "dev",
  "runArgs": ["--cap-drop=ALL"],
  "securityOpt": ["no-new-privileges"],
  "init": true,

  // Prevents VS Code from executing the production CMD upon container startup
  "overrideCommand": true,

  //This opens the port 3002 in the container and maps it to port 3002 on the host machine  
  "appPort": ["3002:3002"],
  // forwardPorts just forward the port to the Client machine running the VS Code
  // "forwardPorts": [3002],

  "containerEnv": {
    "UV_LINK_MODE": "copy"
  },

  "mounts": [
    {
      "source": "${devcontainerId}-uv-cache",
      "target": "/home/dev/.cache/uv",
      "type": "volume"
    }
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },

  "features": {
    "ghcr.io/stu-bell/devcontainer-features/claude-code:0": {}
  },

  "remoteEnv": {
    "ANTHROPIC_MODEL": "qwen3-coder-next",
    "ANTHROPIC_BASE_URL": "http://192.168.1.10:11434",
    "ANTHROPIC_AUTH_TOKEN": "ollama",
    "ANTHROPIC_API_KEY": "ollama",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  }
}